# Site Identity
NEXT_PUBLIC_SITE_URL=https://idahosnowco.com

# Configurable Top Storm Announcement Banner
NEXT_PUBLIC_STORM_BANNER_ENABLED=true
NEXT_PUBLIC_STORM_BANNER_TEXT=❄️ Winter Storm Dispatch Active: Booking McCall, Donnelly & Cascade Crews This Week — Lock In Your Slot

# Analytics & Conversion Tracking (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Twilio SMS Dispatch Alerts (Optional - triggers instant SMS to dispatch phone)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+12085550100
TWILIO_TO_NUMBER=+12089654285

# Resend Email Notifications (Optional - triggers instant quote email)
RESEND_API_KEY=
NOTIFICATION_EMAIL=Boussattaa@gmail.com

# CRM Webhook Integration (forwards qualified snow leads to crm.premiercleaningpro.com)
CRM_WEBHOOK_URL=https://crm.premiercleaningpro.com/api/webhooks/idaho-snow-co
CRM_WEBHOOK_SECRET=replace_with_shared_snow_webhook_secret
